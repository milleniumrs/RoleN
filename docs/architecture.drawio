        <mxCell id="e-cli-ledger" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#757575;endArrow=blockThin;endFill=1" edge="1" parent="1" source="cli" target="ledger">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-cli-projects" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#757575;endArrow=blockThin;endFill=1" edge="1" parent="1" source="cli" target="projects">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===================== edges: core → execution ===================== -->
        <mxCell id="e-rules-runtime" value="routes role → provider/model" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#757575;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#616161" edge="1" parent="1" source="rules" target="runtime">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-orch-adapters" value="schedules tasks" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#757575;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#616161" edge="1" parent="1" source="orch" target="adapters">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-projects-clients" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#757575;endArrow=blockThin;endFill=1" edge="1" parent="1" source="projects" target="clients">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===================== edges: execution → providers ===================== -->
        <mxCell id="e-runtime-api" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#757575;endArrow=blockThin;endFill=1" edge="1" parent="1" source="runtime" target="api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-adapters-agents" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#757575;endArrow=blockThin;endFill=1" edge="1" parent="1" source="adapters" target="agents">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-clients-ollama" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#757575;endArrow=blockThin;endFill=1" edge="1" parent="1" source="clients" target="ollama">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-runtime-clients" value="HTTP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9E9E9E;dashed=1;endArrow=blockThin;endFill=1;fontSize=11;fontColor=#757575" edge="1" parent="1" source="runtime" target="clients">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===================== the single-writer path ===================== -->
        <mxCell id="e-runtime-orch" value="write tickets" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#212121;strokeWidth=3;endArrow=blockThin;endFill=1;fontSize=11;fontStyle=1;exitX=0.25;exitY=0;exitDx=0;exitDy=0" edge="1" parent="1" source="runtime" target="orch">
          <mxGeometry relative="1" as="geometry" />
