        <!-- ===================== edges: state ===================== -->
        <mxCell id="e-projects-cfg" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#BDBDBD;dashed=1;endArrow=none" edge="1" parent="1" source="projects" target="cfg">
