        <mxCell id="e-tui-orch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#757575;endArrow=blockThin;endFill=1" edge="1" parent="1" source="tui" target="orch">
          <mxGeometry relative="1" as="geometry" />
