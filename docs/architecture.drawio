        <mxCell id="e-adapters-orch" value="harvested writes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#212121;strokeWidth=3;endArrow=blockThin;endFill=1;fontSize=11;fontStyle=1;exitX=0.75;exitY=0;exitDx=0;exitDy=0" edge="1" parent="1" source="adapters" target="orch">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-orch-files" value="applies atomically&#10;(base-hash checked)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#212121;strokeWidth=3;endArrow=blockThin;endFill=1;fontSize=11;fontStyle=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0" edge="1" parent="1" source="orch" target="files">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="20" y="295" />
              <mxPoint x="20" y="835" />
